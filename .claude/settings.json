{
    "permissions": {
        "allow": [
            "Bash(git status)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(ls*)",
            "Bash(find . *)",
            "Bash(grep *)",
            "Bash(cat *)",
            "Bash(echo *)",
            "Bash(open *)"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push -f *)",
            "Bash(rm -rf*)",
            "Bash(git reset --hard*)",
            "Bash(git checkout -- *)"
        ]
    },

    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "./.claude/hooks/session-context.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "./.claude/hooks/pre-bash-guard.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "./.claude/hooks/post-edit-sync.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "./.claude/hooks/session-end.sh"
                    }
                ]
            }
        ]
    },

    "mcpServers": {}
}
